+TEST_CASE( "lua_platform_cph_item_footnotes_mod_integration", "[lua][platform][hooks]" )
+{
+    platform_lua_test_directory mod_dir;
+
+    // 1. Write mod definition and Lua files to isolated temp directory
+    mod_dir.write( std::filesystem::u8path( "mod.lua" ), R"lua(
+        local ccb = require("ccb")
+        return ccb.ModDefinition {
+            id = "cph_item_footnotes",
+            name = "末日脚注 / Apocalypse Footnotes",
+            version = "0.1.0",
+            description = "Append humorous footnotes and cold trivia to item descriptions.",
+            dependencies = { "ccb" },
+        }
+    )lua" );
+
+    mod_dir.write( std::filesystem::u8path( "data/footnotes_data.lua" ), R"lua(
+        return {
+            items = {
+                ["rock"] = {
+                    zh = "文明倒退后，它又成了高科技。",
+                    en = "Civilization collapsed and this became cutting-edge technology.",
+                },
+            },
+            variants = {},
+        }
+    )lua" );
+
+    mod_dir.write( std::filesystem::u8path( "data/art_data.lua" ), R"lua(
+        return {
+            items = {
+                ["rock"] = "cph_art_test_rock",
+            },
+            variants = {},
+        }
+    )lua" );
+
+    mod_dir.write( std::filesystem::u8path( "main.lua" ), R"lua(
+        local ccb = rawget(_G, "ccb") or (package and package.loaded and package.loaded["ccb"]) or require("ccb")
+        if not ccb or not ccb.runtime or not ccb.runtime.hook or not ccb.runtime.handler then
+            error("ccb.runtime missing")
+        end
+
+        local footnotes = require("data.footnotes_data")
+        local art_ok, art_data = pcall(require, "data.art_data")
+        if not art_ok or type(art_data) ~= "table" then
+            art_data = { items = {}, variants = {} }
+        end
+
+        local function normalize_lang(lang)
+            if not lang or lang == "" then return "en" end
+            local l = string.lower(string.gsub(lang, "-", "_"))
+            if string.sub(l, 1, 2) == "zh" then return "zh" end
+            return "en"
+        end
+
+        local function on_description_append(payload)
+            if not payload or not payload.item_id then return nil end
+            local effective_lang = normalize_lang(payload.language)
+            local item_entry = footnotes.items and footnotes.items[payload.item_id]
+            if item_entry then
+                local text = item_entry[effective_lang] or item_entry["en"] or item_entry["zh"]
+                if text and text ~= "" then
+                    return { text = text }
+                end
+            end
+            return nil
+        end
+
+        local function on_ascii_art_fallback(payload)
+            if not payload or not payload.item_id then return nil end
+            local art_id = art_data.items and art_data.items[payload.item_id]
+            if art_id and art_id ~= "" then
+                return { art_id = art_id }
+            end
+            return nil
+        end
+
+        ccb.runtime.handler("cph_fn_desc", on_description_append, 1)
+        ccb.runtime.handler("cph_fn_art", on_ascii_art_fallback, 1)
+        ccb.runtime.hook("on_item_description_append", "cph_fn_desc")
+        ccb.runtime.hook("on_item_ascii_art_fallback", "cph_fn_art")
+    )lua" );
+
+    // Register fallback test ascii art
+    JsonObject jo = json_loader::from_string(
+        R"({"id": "cph_art_test_rock", "picture": [" .--. ", "|rock|", " '---' "]})" ).get_object();
+    ascii_art::load_ascii_art( jo, "test" );
+    REQUIRE( ascii_art_id( "cph_art_test_rock" ).is_valid() );
+
+    // Register a native item art to test native art priority over fallback
+    JsonObject jo_native = json_loader::from_string(
+        R"({"id": "test_native_art_ammo", "picture": ["|ammo|"]})" ).get_object();
+    ascii_art::load_ascii_art( jo_native, "test" );
+    REQUIRE( ascii_art_id( "test_native_art_ammo" ).is_valid() );
+
+    // A. Test mod discovery & dependencies
+    cata::lua_platform::mod_definition metadata;
+    std::string loader_error;
+    REQUIRE( cata::lua_platform::read_mod_definition( mod_dir.root, metadata, loader_error ) );
+    CHECK( loader_error.empty() );
+    CHECK( metadata.id == "cph_item_footnotes" );
+    CHECK( metadata.name == "末日脚注 / Apocalypse Footnotes" );
+    CHECK( metadata.version == "0.1.0" );
+    REQUIRE( metadata.dependencies.size() == 1 );
+    CHECK( metadata.dependencies[0] == "ccb" );
+
+    // B. Test mod loading and execution using Platform loader API
+    cata::lua_platform::clear_active_runtimes();
+    on_out_of_scope cleanup( []() {
+        cata::lua_platform::clear_active_runtimes();
+        cata::lua_platform::shutdown();
+        debug_reset_error_observed();
+    } );
+
+    const cata::lua_platform::mod_source source = {
+        metadata.id, mod_dir.root, mod_dir.root / std::filesystem::u8path( metadata.entry )
+    };
+    REQUIRE( cata::lua_platform::prepare_mods( { source }, loader_error ) );
+    CHECK( loader_error.empty() );
+    REQUIRE( cata::lua_platform::apply_prepared_content( loader_error ) );
+    REQUIRE( cata::lua_platform::validate_finalized_prepared_content( loader_error ) );
+    cata::lua_platform::commit_prepared_mods();
+    cata::lua_platform::runtime_world_ready( true );
+
+    // C. Test language switching: English vs Chinese
+    std::optional<std::string> desc_en =
+        cata::lua_platform::dispatch_item_description_append( "rock", std::nullopt, "en" );
+    REQUIRE( desc_en.has_value() );
+    CHECK( desc_en->find( "Civilization collapsed and this became cutting-edge technology." ) != std::string::npos );
+
+    std::optional<std::string> desc_zh =
+        cata::lua_platform::dispatch_item_description_append( "rock", std::nullopt, "zh_CN" );
+    REQUIRE( desc_zh.has_value() );
+    CHECK( desc_zh->find( "文明倒退后，它又成了高科技。" ) != std::string::npos );
+
+    // D. Test item basic_info bilingual switching integration
+#if defined(LOCALIZE)
+    const std::string original_lang = TranslationManager::GetInstance().GetCurrentLanguage();
+    on_out_of_scope restore_lang( [original_lang]() {
+        TranslationManager::GetInstance().SetLanguage( original_lang );
+    } );
+
+    // D1. English language check via basic_info
+    TranslationManager::GetInstance().SetLanguage( "en" );
+    item test_rock( itype_id( "rock" ) );
+    std::vector<iteminfo> info_en;
+    test_rock.basic_info( info_en, &iteminfo_query::all, 1, false );
+    bool found_desc_en = false;
+    for( const iteminfo &ii : info_en ) {
+        if( ii.sName.find( "Civilization collapsed" ) != std::string::npos ||
+            ii.sFmt.find( "Civilization collapsed" ) != std::string::npos ) {
+            found_desc_en = true;
+            break;
+        }
+    }
+    CHECK( found_desc_en );
+
+    // D2. Chinese language switch check via basic_info
+    TranslationManager::GetInstance().SetLanguage( "zh_CN" );
+    std::vector<iteminfo> info_zh;
+    test_rock.basic_info( info_zh, &iteminfo_query::all, 1, false );
+    bool found_desc_zh = false;
+    for( const iteminfo &ii : info_zh ) {
+        if( ii.sName.find( "文明倒退后" ) != std::string::npos ||
+            ii.sFmt.find( "文明倒退后" ) != std::string::npos ) {
+            found_desc_zh = true;
+            break;
+        }
+    }
+    CHECK( found_desc_zh );
+
+    // D3. Switch back to English to verify dynamic responsiveness
+    TranslationManager::GetInstance().SetLanguage( "en" );
+    std::vector<iteminfo> info_en_again;
+    test_rock.basic_info( info_en_again, &iteminfo_query::all, 1, false );
+    bool found_desc_en_again = false;
+    bool found_desc_zh_again = false;
+    for( const iteminfo &ii : info_en_again ) {
+        if( ii.sName.find( "Civilization collapsed" ) != std::string::npos ||
+            ii.sFmt.find( "Civilization collapsed" ) != std::string::npos ) {
+            found_desc_en_again = true;
+        }
+        if( ii.sName.find( "文明倒退后" ) != std::string::npos ||
+            ii.sFmt.find( "文明倒退后" ) != std::string::npos ) {
+            found_desc_zh_again = true;
+        }
+    }
+    CHECK( found_desc_en_again );
+    CHECK_FALSE( found_desc_zh_again );
+#else
+    item test_rock( itype_id( "rock" ) );
+    std::vector<iteminfo> info;
+    test_rock.basic_info( info, &iteminfo_query::all, 1, false );
+    bool found_desc_en = false;
+    for( const iteminfo &ii : info ) {
+        if( ii.sName.find( "Civilization collapsed" ) != std::string::npos ||
+            ii.sFmt.find( "Civilization collapsed" ) != std::string::npos ) {
+            found_desc_en = true;
+            break;
+        }
+    }
+    CHECK( found_desc_en );
+#endif
+
+    // E. Test missing native art uses mod ascii art fallback
+    CHECK_FALSE( test_rock.type->picture_id.is_valid() ); // rock has no native art
+    std::optional<std::string> art_fallback =
+        cata::lua_platform::dispatch_item_ascii_art_fallback( "rock", std::nullopt, "en" );
+    REQUIRE( art_fallback.has_value() );
+    CHECK( *art_fallback == "cph_art_test_rock" );
+
+    std::vector<iteminfo> art_info;
+    test_rock.ascii_art_info( art_info, &iteminfo_query::all, 1, false );
+    bool found_fallback_art = false;
+    for( const iteminfo &ii : art_info ) {
+        if( ii.sName.find( "|rock|" ) != std::string::npos ||
+            ii.sFmt.find( "|rock|" ) != std::string::npos ) {
+            found_fallback_art = true;
+            break;
+        }
+    }
+    CHECK( found_fallback_art );
+
+    // F. Test native art priority over fallback
+    // If an item has native art, basic_info / ascii_art_info renders native art directly
+    item test_ammo( itype_id( "rock" ) );
+    // Assign native picture_id to simulate an item with native art
+    const_cast<itype *>( test_ammo.type )->picture_id = ascii_art_id( "test_native_art_ammo" );
+    REQUIRE( test_ammo.type->picture_id.is_valid() );
+
+    std::vector<iteminfo> native_art_info;
+    test_ammo.ascii_art_info( native_art_info, &iteminfo_query::all, 1, false );
+    bool found_native_art = false;
+    bool found_fallback_on_native = false;
+    for( const iteminfo &ii : native_art_info ) {
+        if( ii.sName.find( "|ammo|" ) != std::string::npos ||
+            ii.sFmt.find( "|ammo|" ) != std::string::npos ) {
+            found_native_art = true;
+        }
+        if( ii.sName.find( "|rock|" ) != std::string::npos ||
+            ii.sFmt.find( "|rock|" ) != std::string::npos ) {
+            found_fallback_on_native = true;
+        }
+    }
+    CHECK( found_native_art );
+    CHECK_FALSE( found_fallback_on_native );
+
+    // Reset rock picture_id
+    const_cast<itype *>( test_ammo.type )->picture_id = ascii_art_id();
+
+    // G. Test MOD enable and disable
+    cata::lua_platform::clear_active_runtimes();
+    cata::lua_platform::shutdown();
+    std::optional<std::string> disabled_desc =
+        cata::lua_platform::dispatch_item_description_append( "rock", std::nullopt, "en" );
+    CHECK_FALSE( disabled_desc.has_value() );
+    std::optional<std::string> disabled_art =
+        cata::lua_platform::dispatch_item_ascii_art_fallback( "rock", std::nullopt, "en" );
+    CHECK_FALSE( disabled_art.has_value() );
+}
