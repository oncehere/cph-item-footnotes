+bool is_valid_utf8_and_clean_controls( const std::string &str, bool allow_newlines )
+{
+    const unsigned char *bytes = reinterpret_cast<const unsigned char *>( str.data() );
+    const std::size_t len = str.size();
+    std::size_t i = 0;
+    while( i < len ) {
+        unsigned char c = bytes[i];
+        if( c < 0x80 ) {
+            if( c == 0x7F ) { // DEL
+                return false;
+            }
+            if( c < 32 ) {
+                if( allow_newlines ) {
+                    if( c == '\n' ) {
+                        ++i;
+                        continue;
+                    }
+                    if( c == '\r' ) {
+                        // CRLF is allowed, lone CR is forbidden
+                        if( i + 1 < len && bytes[i + 1] == '\n' ) {
+                            i += 2;
+                            continue;
+                        }
+                        return false;
+                    }
+                }
+                return false;
+            }
+            ++i;
+        } else if( ( c & 0xE0 ) == 0xC0 ) {
+            // 2-byte sequence: 0xC2..0xDF
+            if( c < 0xC2 || i + 1 >= len ) {
+                return false;
+            }
+            unsigned char c1 = bytes[i + 1];
+            if( ( c1 & 0xC0 ) != 0x80 ) {
+                return false;
+            }
+            // Reject C1 control characters (U+0080..U+009F -> 0xC2 0x80..0xC2 0x9F)
+            if( c == 0xC2 && c1 <= 0x9F ) {
+                return false;
+            }
+            i += 2;
+        } else if( ( c & 0xF0 ) == 0xE0 ) {
+            // 3-byte sequence: 0xE0..0xEF
+            if( i + 2 >= len ) {
+                return false;
+            }
+            unsigned char c1 = bytes[i + 1];
+            unsigned char c2 = bytes[i + 2];
+            if( ( c1 & 0xC0 ) != 0x80 || ( c2 & 0xC0 ) != 0x80 ) {
+                return false;
+            }
+            if( c == 0xE0 && c1 < 0xA0 ) { // overlong
+                return false;
+            }
+            if( c == 0xED && c1 >= 0xA0 ) { // surrogate U+D800..U+DFFF
+                return false;
+            }
+            i += 3;
+        } else if( ( c & 0xF8 ) == 0xF0 ) {
+            // 4-byte sequence: 0xF0..0xF4
+            if( i + 3 >= len ) {
+                return false;
+            }
+            unsigned char c1 = bytes[i + 1];
+            unsigned char c2 = bytes[i + 2];
+            unsigned char c3 = bytes[i + 3];
+            if( ( c1 & 0xC0 ) != 0x80 || ( c2 & 0xC0 ) != 0x80 || ( c3 & 0xC0 ) != 0x80 ) {
+                return false;
+            }
+            if( c == 0xF0 && c1 < 0x90 ) { // overlong
+                return false;
+            }
+            if( c == 0xF4 && c1 > 0x8F ) { // out of range > U+10FFFF
+                return false;
+            }
+            if( c > 0xF4 ) {
+                return false;
+            }
+            i += 4;
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
